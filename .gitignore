# Build output
build/
!.claude/skills/build/
*.o
*.lst
*.map
*.sym
*.ihx

# ROM files
*.gb
*.gbc

# Save files
*.sav
*.srm

# GBTD / GBMB project files
*.gbr
*.gbm

# macOS
.DS_Store

# Windows
Thumbs.db
desktop.ini

# Linux
*~

# Editor
.vscode/
.idea/
*.swp
*.swo
*.tiled-session

# Git worktrees
.worktrees/
.claude/worktrees/


# Python
__pycache__/
*.pyc
*.pyo

# Emulicious emulator
Emulicious.jar

# Implementation plans (local only, never pushed)
docs/plans/

# Personal / machine-specific Claude instructions
CLAUDE.local.md

# Claude scratch settings tier — transient session approvals, never committed
# (see ADR 443)
.claude/settings.local.json

# Superpowers SDD workspace (transient ledger written by baseline subagent-driven-development)
.superpowers/

# Factory run registry — screenshots, traces, and absolute worktree paths.
# Created by tools/factory_run.py; never committed (see issue #436 R10).
.factory/

# Derived knowledge-graph output (regenerated by /understand-knowledge)
knowledge/.understand-anything/

# Coverage artifacts — gcov data from `make coverage` (#699). build/ already
# covers build/coverage/; these catch a gcov run started outside it.
*.gcda
*.gcno
*.gcov
*.gcov.json.gz

# Claude Code memory stores are machine-local (keyed by encoded cwd) and must
# never be committed — a store keyed to another machine's path is dead weight.
.claude/projects/
