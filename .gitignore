docs/plans/

# Personal / machine-specific Claude instructions
CLAUDE.local.md

# Claude scratch settings tier — transient session approvals, never committed
# (see ADR 443)
.claude/settings.local.json

# Pi harness (issue #497). Deny-all-then-allow so anything Pi writes at
# runtime — .pi/npm/ for project package installs, .pi/sessions/, and whatever
# a later version adds — stays local, while the two committed files remain
# tracked. Note `.pi/*` and not `.pi/`: git must still descend into the
# directory for the negations below to be reachable.
.pi/*
!.pi/settings.json
!.pi/agents/

# pi-subagents run artifacts (transcripts, per-agent input/output at repo root)
.pi-subagents/


# Superpowers SDD workspace (transient ledger written by baseline subagent-driven-development)
.superpowers/

# Factory run registry — screenshots, traces, and absolute worktree paths.
# Created by tools/factory_run.py; never committed (see issue #436 R10).
.factory/
